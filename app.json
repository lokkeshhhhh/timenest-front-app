{
  "expo": {
    "name": "Arcana",
    "slug": "arcana",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/arcana-icon.png",
    "splash": {
      "backgroundColor": "#0A0A0A"
    },
    "scheme": "arcana",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0A0A"
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Arcana uses your location to verify clock-in/clock-out happens at an approved workplace."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
